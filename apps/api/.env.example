# Server Configuration
PORT=4000
NODE_ENV=development

# CORS Configuration (comma-separated origins allowed)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Connection via Prisma
DATABASE_URL=postgresql://dropvault_user:Tanmay%40123@localhost:5432/dropvault?schema=public

# Authentication & Security
# Minimum 32-character high-entropy secret keys
JWT_ACCESS_SECRET=dropvault_super_secret_access_jwt_key_at_least_32_chars_2026
JWT_REFRESH_SECRET=dropvault_super_secret_refresh_jwt_key_at_least_32_chars_2026
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_DOMAIN=localhost
