datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum FileStatus {
  PENDING
  AVAILABLE
  EXPIRED
  DELETED
  FAILED
}

enum StorageProvider {
  LOCAL
  S3
}

enum UploadStatus {
  INITIALIZED
  IN_PROGRESS
  COMPLETED
  ABORTED
}

enum AccessEventType {
  VIEW
  DOWNLOAD_ATTEMPT
  DOWNLOAD_SUCCESS
  PASSWORD_FAILED
  LIMIT_REACHED
  REVOKED_ATTEMPT
}

// ----------------------------------------------------
// 1. Users
// ----------------------------------------------------
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  name         String?
  role         Role          @default(USER)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  sessions     UserSession[]
  files        File[]

  @@map("users")
}

// ----------------------------------------------------
// 2. User Sessions (Refresh Tokens & Token Families)
// ----------------------------------------------------
model UserSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  familyId     String    @map("family_id")
  tokenHash    String    @unique @map("token_hash")
  isUsed       Boolean   @default(false) @map("is_used")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ----------------------------------------------------
// 3. Files (Anonymous & Authenticated)
// ----------------------------------------------------
model File {
  id               String                @id @default(uuid())
  userId           String?               @map("user_id") // Nullable -> null = Anonymous upload
  originalName     String                @map("original_name")
  storageKey       String                @unique @map("storage_key")
  mimeType         String                @map("mime_type")
  sizeBytes        BigInt                @map("size_bytes")
  storageProvider  StorageProvider       @default(LOCAL) @map("storage_provider")
  status           FileStatus            @default(PENDING)
  expiresAt        DateTime              @map("expires_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  managementToken  FileManagementToken?
  shareLinks       ShareLink[]
  uploadSession    UploadSession?
  accessLogs       AccessLog[]

  @@index([userId])
  @@index([expiresAt])
  @@index([status])
  @@map("files")
}

// ----------------------------------------------------
// 4. Anonymous File Management Tokens
// ----------------------------------------------------
model FileManagementToken {
  id           String    @id @default(uuid())
  fileId       String    @unique @map("file_id")
  tokenHash    String    @unique @map("token_hash")
  rotatedAt    DateTime? @map("rotated_at")
  revokedAt    DateTime? @map("revoked_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  file         File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("file_management_tokens")
}

// ----------------------------------------------------
// 5. Share Links (Public Links with Dual-Token Security)
// ----------------------------------------------------
model ShareLink {
  id            String      @id @default(uuid())
  fileId        String      @map("file_id")
  shortCode     String      @unique @map("short_code")
  tokenHash     String?     @unique @map("token_hash")
  passwordHash  String?     @map("password_hash")
  maxDownloads  Int?        @map("max_downloads")
  downloadCount Int         @default(0) @map("download_count")
  isRevoked     Boolean     @default(false) @map("is_revoked")
  expiresAt     DateTime?   @map("expires_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  file          File        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  accessLogs    AccessLog[]

  @@index([fileId])
  @@index([shortCode])
  @@map("share_links")
}

// ----------------------------------------------------
// 6. Access Logs (Audit Trail with Soft Association)
// ----------------------------------------------------
model AccessLog {
  id                      String          @id @default(uuid())
  fileId                  String?         @map("file_id")
  shareLinkId             String?         @map("share_link_id")
  fileIdentifierSnapshot  String          @map("file_identifier_snapshot")
  eventType               AccessEventType @map("event_type")
  ipAddress               String?         @map("ip_address")
  userAgent               String?         @map("user_agent")
  createdAt               DateTime        @default(now()) @map("created_at")

  file                    File?           @relation(fields: [fileId], references: [id], onDelete: SetNull)
  shareLink               ShareLink?      @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  @@index([fileId])
  @@index([shareLinkId])
  @@index([createdAt])
  @@map("access_logs")
}

// ----------------------------------------------------
// 7. Upload Sessions (Multipart Upload Foundation)
// ----------------------------------------------------
model UploadSession {
  id                String       @id @default(uuid())
  fileId            String       @unique @map("file_id")
  uploadId          String?      @map("upload_id")
  expectedSizeBytes BigInt       @map("expected_size_bytes")
  chunkCount        Int          @default(1) @map("chunk_count")
  status            UploadStatus @default(INITIALIZED)
  expiresAt         DateTime     @map("expires_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  file              File         @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("upload_sessions")
}
